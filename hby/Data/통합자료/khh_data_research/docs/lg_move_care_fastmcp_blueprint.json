{
  "project": "LG Move Care",
  "artifact_type": "설계 초안 — 실행 가능한 FastMCP 서버가 아님",
  "as_of": "2026-10-12",
  "architecture": "React -> FastAPI(인증·세션·동의·업무상태) -> LangChain agent -> curated FastMCP tools -> Mock 데이터/공개 주소 API/검수 정책 RAG",
  "version_note": "현재 확인한 LangChain 공식문서는 MCPAdapter(langchain[mcp]>=1.4.0, beta) 사용. FastMCP/SDK/LangChain 버전을 lockfile로 고정하고 해당 버전 문서를 사용.",
  "source_registry": "lg_move_care_sources.json",
  "tools": [
    {
      "name": "get_contract",
      "mode": "read",
      "inputs": {
        "contract_id": "string"
      },
      "server_context": [
        "authenticated_subject",
        "authorized_contract_ids"
      ],
      "outputs": [
        "contract_id",
        "product_category",
        "model",
        "contract_start_date",
        "mandatory_end_date",
        "contract_end_date",
        "monthly_base_krw",
        "billing_schedule",
        "care_mode",
        "care_cycle_months",
        "ownership_terms",
        "terms_version",
        "source_kind"
      ],
      "rules": [
        "사용자가 입력한 고객 ID만으로 조회를 허용하지 않음",
        "계약당사자/등록 실사용자의 허용 범위를 서버에서 검증",
        "SUBSCRIPTION과 CARESHIP을 구분"
      ]
    },
    {
      "name": "normalize_address",
      "mode": "read",
      "inputs": {
        "address_query": "string"
      },
      "outputs": [
        "candidates",
        "road_address",
        "zip_no",
        "administrative_code",
        "building_id",
        "needs_user_selection"
      ],
      "data": "행안부 주소 API 또는 명시적 Mock",
      "rules": [
        "복수 후보를 임의로 선택하지 않음",
        "주소가 유효하다고 방문관리 가능으로 판단하지 않음"
      ]
    },
    {
      "name": "check_service_coverage",
      "mode": "read",
      "inputs": {
        "contract_id": "string",
        "address_ref": "string",
        "move_date": "date"
      },
      "outputs": [
        "status: AVAILABLE|UNAVAILABLE|UNKNOWN",
        "reason_code",
        "checked_at",
        "source_kind: MOCK|INTERNAL_CONFIRMED",
        "care_modes_supported"
      ],
      "data": "Mock 관리지역 데이터. 공개 주소 API와 별개.",
      "rules": [
        "공개 자료만으로 실제 LG 관리지역 판정 불가",
        "도서지역 전체를 불가로 하드코딩하지 않음",
        "UNKNOWN을 UNAVAILABLE로 치환하지 않음"
      ]
    },
    {
      "name": "search_policy",
      "mode": "read",
      "inputs": {
        "query": "string",
        "product_category": "string",
        "terms_version": "string|null",
        "effective_on": "date"
      },
      "outputs": [
        "passages",
        "source_id",
        "source_url",
        "section",
        "effective_from",
        "effective_to",
        "retrieved_at",
        "applicability",
        "conflicts"
      ],
      "data": "검수한 LG 공식문서 및 소비자분쟁해결기준/표준답변. VOC 제외.",
      "rules": [
        "브랜드·품목·가입시점·계약종류 필터",
        "블로그·댓글을 위약금 또는 면제 근거로 쓰지 않음",
        "OCR 오류 문서의 계산식은 검수 전 제외",
        "법령/분쟁기준과 계약상 산정액을 별도 레이어로 반환"
      ]
    },
    {
      "name": "quote_options",
      "mode": "read",
      "inputs": {
        "contract_id": "string",
        "address_ref": "string",
        "effective_date": "date",
        "comparison_end_date": "date"
      },
      "outputs": [
        "quote_id",
        "contract_snapshot_version",
        "policy_version",
        "expires_at",
        "keep_one_time_cost_krw",
        "keep_future_payments_krw",
        "cancel_known_subtotal_krw",
        "cancel_total_estimate_krw",
        "fee_breakdown",
        "unknown_items",
        "assumptions",
        "retained_benefits",
        "lost_benefits",
        "dispute_reference"
      ],
      "rules": [
        "금액은 정수 원 또는 Decimal로 계산",
        "할인 전 기본요금과 실제 납부/카드할인액을 구분",
        "실제 날짜와 계약 일할/반올림 규칙을 사용; 규칙 미확인 시 경계일 계산 보류",
        "이미 지불한 비용과 앞으로 발생하는 비용을 분리",
        "할인 종료/요금변경을 반영한 동일 기간 비교",
        "미확인 비용을0으로 숨기지 않고 전체합계null 및 확인된 소계 제시",
        "조회 실패를 무료 또는0원으로 해석하지 않음",
        "분쟁해결기준과 계약 기준이 다르면 상담 확인 플래그; 임의 면제하지 않음"
      ]
    },
    {
      "name": "prepare_address_change",
      "mode": "read",
      "inputs": {
        "contract_id": "string",
        "address_ref": "string",
        "move_date": "date",
        "quote_id": "string"
      },
      "outputs": [
        "draft_id",
        "payload_hash",
        "masked_confirmation_summary",
        "expires_at",
        "required_consent_scope"
      ],
      "rules": [
        "초안 작성이며 실제 주소 변경/접수 아님",
        "고객이 주소·날짜·견적을 검토할 수 있게 표시"
      ]
    },
    {
      "name": "submit_address_change",
      "mode": "write",
      "inputs": {
        "draft_id": "string",
        "consent_id": "string",
        "idempotency_key": "string"
      },
      "outputs": [
        "request_id",
        "status: REQUESTED",
        "source_kind: MOCK",
        "submitted_at"
      ],
      "rules": [
        "동의 기록은 React 확인 동작을 받은 FastAPI가 발급; LLM이 consent=true를 넣는 방식 금지",
        "동의를 인증된 사용자·행위·초안 payload_hash·견적 버전·유효기간에 결합",
        "변경된 주소/날짜/견적은 재검토 및 재동의 필요",
        "견적 유효성과 관리 가능 여부 재검증",
        "멱등키와 payload_hash를 원자적으로 기록; 같은 키+다른 내용은 거절",
        "재시도는 기존 신청번호 반환",
        "REQUESTED를 예약확정/처리완료로 표현하지 않음"
      ]
    },
    {
      "name": "create_counseling_handoff",
      "mode": "write",
      "inputs": {
        "contract_id": "string",
        "handoff_draft_id": "string",
        "consent_id": "string",
        "idempotency_key": "string"
      },
      "outputs": [
        "handoff_id",
        "status: REQUESTED",
        "source_kind: MOCK"
      ],
      "rules": [
        "상담 목적·전달 정보에 별도 동의",
        "계약 요약·예상비용·근거·미확인 사항·고객 희망을 전달",
        "계약 해지 실행 및 위약금 면제 확정 Tool은 MVP에 노출하지 않음"
      ]
    }
  ],
