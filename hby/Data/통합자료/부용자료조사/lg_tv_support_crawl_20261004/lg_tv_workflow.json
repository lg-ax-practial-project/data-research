{
  "name": "LG TV Official FAQ and Self Help Collector",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-tv",
      "name": "Manual collection",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8766/collect",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-LG-Crawler",
              "value": "manual-local"
            }
          ]
        },
        "options": {
          "timeout": 180000
        }
      },
      "id": "collect-tv",
      "name": "Collect official TV pages to local Git",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        280,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nif (!r.raw_hashes_verified || r.article_count === 0 || r.review_count > 0) throw new Error('Collection requires review: ' + JSON.stringify(r));\nreturn [{json: {...r, status: 'Collected and hash verified', note: 'FAQ and self-help documents are not customer incidents, general legal rules, or confirmed diagnoses. Manual review required before RAG deployment.'}}];"
      },
      "id": "verify-tv",
      "name": "Verify and report counts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        0
      ]
    }
  ],
  "connections": {
    "Manual collection": {
      "main": [
        [
          {
            "node": "Collect official TV pages to local Git",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Collect official TV pages to local Git": {
      "main": [
        [
          {
            "node": "Verify and report counts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}
