{
  "markdown": "약관 선택\n\n확인",
  "rawHtml": "<!DOCTYPE html><html lang=\"ko\" class=\" js \"><head><meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">\n\t<title></title>\n\t\n\t\n\t<meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n\t<!-- <meta http-equiv=\"Pragma\" content=\"no-cache\" /> -->\n\t<!-- <meta http-equiv=\"Cache-control\" content=\"no-cache\" /> -->\n\t<meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0,maximum-scale=1.0,minimum-scale=1.0,user-scalable=no\">\n\t<link rel=\"shortcut icon\" type=\"image/x-icon\" href=\"https://kr.m.lgaccount.com/resources/images/favicon.ico\">\n\n\t<link type=\"text/css\" rel=\"stylesheet\" href=\"https://kr.m.lgaccount.com/resources/div_cm/css/style.css?v=4.6\">\n\n\n\t<link type=\"text/css\" rel=\"stylesheet\" href=\"https://kr.m.lgaccount.com/resources/div_cm/css/ko-kr.css\">\n\n\n\n\n\n\t\n\n\n<!-- common.js = jquery.js + jquery.cookie.js + jquery.storage.js + md5.js + sha1.js + sha512.js + jencrypt.js + plugin.js + hmac-sha256.js + enc-base64-min.js + Base64.js -->\n<script type=\"text/javascript\" src=\"https://kr.m.lgaccount.com/resources/js/new/lib/common_v1.0.js\"></script>\n<script type=\"text/javascript\" src=\"https://kr.m.lgaccount.com/resources/js/new/lib/Crypto.sha512.js\"></script>\n<script type=\"text/javascript\" src=\"https://kr.m.lgaccount.com/resources/js/new/config/config.js?v=1.2\"></script>\n<script type=\"text/javascript\" src=\"https://kr.m.lgaccount.com/resources/js/new/config/locale_config.js?v=0.2\"></script>\n<script type=\"text/javascript\">\nvar LayerPopup = {\n\tIS_USE : false,\n\tIS_SHOW : false,\n\tmake : function(type, id, message, callbackData) {\n\t\tvar _THIS = this,\n\t\t\tbtnName1 = '확인',\n\t\t\tbtnName2 = '취소'\n\t\t\t;\n\n\t\tmessage = message.replace(/\\n/g, \"<br/>\");\n\n\t\tvar layerId = \"layerPopup_\" + id;\n\t\tvar html = '<div id=\"' + layerId + '\" class=\"hna_gid_pop\"><div class=\"pop_warp\">';\n\t\thtml += '<div class=\"pop_contents\"><div class=\"pop_contents_subject\">';\n\t\thtml += message + '</div></div>';\n\n\t\tif(type === \"A\") {\n\t\t\thtml += '<div class=\"pop_btn\"><div class=\"pop_btn1\">';\n\t\t}\n\t\tif(type === \"C\") {\n\t\t\thtml += '<div class=\"pop_btn\"><div class=\"pop_btn2\">';\n\t\t}\n\n\t\thtml += '<button type=\"button\" class=\"btn_ok\"><span>' + btnName1 + '</span></button>';\n\t\tif(type === \"C\") {\n\t\t\thtml += '<button type=\"button\" class=\"btn_close\"><span>' + btnName2 + '</span></button>';\n\t\t}\n\n\t\thtml += '</div></div>';\n\t\thtml += '</div></div>';\n\n\t\t$('body').append( html );\n\n\t\t$(\"#\" + layerId).css(\"display\",\"block\");\n\t\tvar tx = ($(window).width()-$(\"#\" + layerId + \" .pop_warp\").width())/2;\n\t\tvar ty = ($(window).height()-$(\"#\" + layerId + \" .pop_warp\").height())/2;\n\t\t$(\"#\" + layerId + \" .pop_warp\").css({left:tx+\"px\",top:ty+\"px\"});\n\t\t$(\"body\").css(\"overflow\",\"hidden\");\n\t\t$(\"body\").css(\"pointer-events\", \"\");\n\n\t\tif(type === \"A\") {\n\t\t\t$(\"#\" + layerId + \" .btn_ok\").on(\"click\", function(e){\n\t\t\t\te.preventDefault();\n\t\t\t\t_THIS.remove(layerId);\n\t\t\t\t_THIS.callFuncA(id, callbackData);\n\t\t\t});\n\t\t}\n\t\tif(type === \"C\") {\n\t\t\t$(\"#\" + layerId + \" .btn_ok\").on(\"click\", function(e){\n\t\t\t\te.preventDefault();\n\t\t\t\t_THIS.remove(layerId);\n\t\t\t\t_THIS.callFuncC(id, \"T\", callbackData);\n\t\t\t});\n\t\t\t$(\"#\" + layerId + \" .btn_close\").on(\"click\", function(e){\n\t\t\t\te.preventDefault();\n\t\t\t\t_THIS.remove(layerId);\n\t\t\t\t_THIS.callFuncC(id, \"F\", callbackData);\n\t\t\t});\n\t\t}\n\t\t_THIS.IS_SHOW = true;\n\t\t$(\".hna_gid_pop\").css(\"z-index\",\"110000\");\n\t},\n\tremove : function(layerId) {\n\t\t$(\"body\").css(\"overflow\",\"auto\");\n\t\t$(\"#\" + layerId + \" .btn_ok\").off(\"click\");\n\t\t$(\"#\" + layerId + \" .btn_close\").off(\"click\");\n\t\t$(\"body #\" + layerId).remove();\n\t\tthis.IS_SHOW = false;\n\t},\n\tcallback : {},\n\tcallFuncA : function(id, callbackData) {\n\t\tif(this.callback[id]) {\n\t\t\tLGMUtil.debug(\"===== LayerPopup ID callback START: \", id);\n\t\t\tif(callbackData)\n\t\t\t\tthis.callback[id](callbackData);\n\t\t\telse\n\t\t\t\tthis.callback[id]();\n\t\t\tLGMUtil.debug(\"===== LayerPopup ID callback END  : \", id);\n\t\t}\n\t},\n\tcallFuncC : function(id, flag, callbackData) {\n\t\tif(this.callback[id]) {\n\t\t\tif(this.callback[id][flag]) {\n\t\t\t\tLGMUtil.debug(\"===== LayerPopup ID callback START: \", id);\n\t\t\t\tif(callbackData)\n\t\t\t\t\tthis.callback[id][flag](callbackData);\n\t\t\t\telse\n\t\t\t\t\tthis.callback[id][flag]();\n\t\t\t\tLGMUtil.debug(\"===== LayerPopup ID callback END  : \", id);\n\t\t\t}\n\t\t}\n\t},\n\talert : function(id, message, callbackData) {\n\t\tif(this.IS_USE) {\n\t\t\tthis.make(\"A\", id, message, callbackData);\n\t\t}\n\t\telse {\n\t\t\talert(message);\n\t\t\tif(\"_tmp\" !== id.slice(id.length-4, id.length)) {\n\t\t\t\tthis.callFuncA(id, callbackData);\n\t\t\t}\n\t\t}\n\t},\n\tconfirm : function(id, message, callbackData) {\n\t\tif(this.IS_USE) {\n\t\t\tthis.make(\"C\", id, message, callbackData);\n\t\t}\n\t\telse {\n\t\t\t$('body').addClass(\"blur\");\n\t\t\tsetTimeout(function(){\n\t\t\t\tif(confirm(message)){\n\t\t\t\t\t$('body').removeClass(\"blur\");\n\t\t\t\t\tLayerPopup.callFuncC(id, \"T\", callbackData);  \n\t\t\t\t}\n\t\t\t\telse{\n\t\t\t\t\t$('body').removeClass(\"blur\");\n\t\t\t\t\tLayerPopup.callFuncC(id, \"F\", callbackData);  \n\t\t\t\t}\n\t\t\t}, 100);\n\n\t\t}\n\t}\n};\n\n</script>\n<script type=\"text/javascript\" src=\"https://kr.m.lgaccount.com/resources/js/new/util/util.js?v=3.5\"></script>\n<script type=\"text/javascript\" src=\"https://kr.m.lgaccount.com/resources/js/new/net/network.js?v=0.6\"></script>\n<script type=\"text/javascript\" src=\"https://kr.m.lgaccount.com/resources/js/new/storage/storage.js\"></script>\n<!--script type=\"text/javascript\" src=\"/resources/js/new/lib/jquery.nicescroll.min.js\"></script-->\n\n<scr