 : '멕시코',\n\t\"MY\" : '말레이시아',\n\t\"NE\" : '니제르',\n\t\"NG\" : '나이지리아',\n\t\"NI\" : '니카과라',\n\t\"NL\" : '네덜란드',\n\t\"NO\" : '노르웨이',\n\t\"NP\" : '네팔',\n\t\"NZ\" : '뉴질랜드',\n\t\"OM\" : '오만',\n\t\"PA\" : '파나마',\n\t\"PE\" : '페루',\n\t\"PH\" : '필리핀',\n\t\"PK\" : '파키스탄',\n\t\"PL\" : '폴란드',\n\t\"PR\" : '푸에르토리코',\n\t\"PS\" : '팔레스타인',\n\t\"PT\" : '포르투갈',\n\t\"PY\" : '파라과이',\n\t\"QA\" : '카타르',\n\t\"RO\" : '루마니아',\n\t\"RS\" : '세르비아',\n\t\"RU\" : '러시아',\n\t\"RW\" : '르완다',\n\t\"SA\" : '사우디아라비아',\n\t\"SC\" : '세이셸',\n\t\"SD\" : '수단',\n\t\"SE\" : '스웨덴',\n\t\"SG\" : '싱가포르',\n\t\"SI\" : '슬로베니아',\n\t\"SK\" : '슬로바키아',\n\t\"SL\" : '시에라리온',\n\t\"SN\" : '세네갈',\n\t\"SO\" : '소말리아',\n\t\"ST\" : '상투메프린시페',\n\t\"SV\" : '엘살바도르',\n\t\"SY\" : '시리아',\n\t\"TD\" : '차드',\n\t\"TG\" : '토고',\n\t\"TH\" : '태국',\n\t\"TN\" : '튀니지',\n\t\"TR\" : '터키',\n\t\"TW\" : '대만',\n\t\"TZ\" : '탄자니아',\n\t\"UA\" : '우크라이나',\n\t\"UG\" : '우간다',\n\t\"US\" : '미국',\n\t\"UY\" : '우루과이',\n\t\"UZ\" : '우즈베키스탄',\n\t\"VE\" : '베네수엘라',\n\t\"VN\" : '베트남',\n\t\"XK\" : '코소보',\n\t\"YT\" : '마요트',\n\t\"ZA\" : '남아프리카공화국',\n\t\"ZM\" : '잠비아'\n};\n</script>\n\n\n\n<script type=\"text/javascript\">\nLGMM.ERROR=(function(){\n\n   \n\tfunction _getHttpStatusErrorData(__opt){\n\t\tvar __msg = '';\n\t\tswitch(__opt){\n\t\t\tcase '400':\n\t\t\t\t__msg = \"400 Bad Request\";\n\t\t\tbreak;\n\t\t\tcase '401':\n\t\t\t\t__msg = \"401 Unauthorized\";\n\t\t\tbreak;\n\t\t\tcase '403':\n\t\t\t\t__msg = \"403 Forbidden\";\n\t\t\tbreak;\n\t\t\tcase '405':\n\t\t\t\t__msg = \"405 Method Not Allowed\";\n\t\t\tbreak;\n\t\t\tcase '406':\n\t\t\t\t__msg = \"406 Not Acceptable\";\n\t\t\tbreak;\n\t\t\tcase '411':\n\t\t\t\t__msg = \"411 Length Required\";\n\t\t\tbreak;\n\t\t\tcase '412':\n\t\t\t\t__msg = \"412 Precondition Failed\";\n\t\t\tbreak;\n\t\t\tcase '500':\n\t\t\t\t__msg = \"500 Internal Server Error\";\n\t\t\tbreak;\n\t\t}\n\n\t\treturn {msg: __msg};\n\t}\n\n\t\n\tfunction _getPlatformError(__opt){\n\t\tvar obj = null;\n\t\tswitch(__opt){\n\t\t\tcase 'EMP.100':\n\t\t\t\tobj = {msg:'EMP.100 Invalid request error'};\n\t\t\tbreak;\n\t\t\tcase 'EMP.101':\n\t\t\t\tobj = {msg:'EMP.101 Invalid mandatory parameter(s)'};\n\t\t\tbreak;\n\t\t\tcase 'EMP.102':\n\t\t\t\tobj = {msg:'EMP.102 Invalid request error'};\n\t\t\tbreak;\n\t\t\tcase 'EMP.103':\n\t\t\t\tobj = {msg:'EMP.103 Invalid request error'};\n\t\t\tbreak;\n\t\t\tcase 'EMP.105':\n\t\t\t\tobj = {msg:'EMP.105 Request System IP address is not authorized by Service Platform'};\n\t\t\tbreak;\n\t\t\tcase 'EMP.106':\n\t\t\t\tobj = {msg:'EMP.106 Invalid request error a country'};\n\t\t\tbreak;\n\t\t\tcase 'EMP.900':\n\t\t\t\tobj = {msg:'EMP.900 Service Platform exception in system handling'};\n\t\t\tbreak;\n\t\t\tcase 'EMP.901':\n\t\t\t\tobj = {msg:'EMP.901 Service Platform external error'};\n\t\t\tbreak;\n\t\t}\n\n\t\treturn obj;\n\t}\n\n\t\n\tvar _getMembershipMobileErr = function (__opt){\n\t\tvar obj = {msg:''};\n\n\t\tswitch(__opt){\n\t\t\tcase 'alert.03':    \n\t\t\t\tobj = {msg:\"인증 메일이 재발송 되었습니다.\"};\n\t\t\tbreak;\n\t\t\tcase 'alert.14':    \n\t\t\t\tobj = {msg:\"비밀번호 변경이 완료되었습니다.\"};\n\t\t\tbreak;\n\t\t\tcase 'alert.19':    \n\t\t\t\tobj = {msg:\"13자리 이상 설정 시 기존에 사용하시던 서비스 및 디바이스에서는 로그인에 제한을 받을 수 있습니다. 입력하신 비밀번호로 설정하시겠습니까?\"};\n\t\t\tbreak;\n\t\t\tcase 'alert.20':    \n\t\t\t\tobj = {msg:\"고객님의 LG전자 계정으로 다른 서비스는 정상 이용 하실 수 있습니다. 서비스 탈퇴를 계속 하시겠습니까?\"};\n\t\t\tbreak;\n\t\t\tcase 'alert.22' :    \n\t\t\t\tobj = {msg:\"서비스를 이용하기 위해서는 본인 인증이 필요합니다.\"};\n\t\t\tbreak;\n\t\t\tcase 'alert.24':    \n\t\t\t\tobj = {msg:\"LG전자 계정과 가입된 모든 서비스에서 탈퇴 처리됩니다. 계속 하시겠습니까?\"};\n\t\t\tbreak;\n\t\t\tcase 'alert.25':    \n\t\t\t\tobj = {msg:\"해당 서비스에 이미 가입되었습니다.\"};\n\t\t\tbreak;\n\t\t\tcase 'alert.26':    \n\t\t\t\tobj = {msg:\"해당 영수 아이디는 이메일 아이디로 이미 전환되었습니다. 전환하신 이메일 아이디로 로그인하시기 바랍니다.\"};\n\t\t\tbreak;\n\t\t\tcase 'alert.27':    \n\t\t\t\tobj = {msg:\"URL로 접근할 수 없는 페이지입니다. 네트워크 상태를 확인하신 후 다시 접속하시기 바랍니다.\"};\n\t\t\tbreak;\n\t\t\tcase 'alert.28':    \n\t\t\t\tobj = {msg:\"입력하신 정보는 다른 계정의 보조 메일로 등록되어 있는