  "rawHtml": "<!DOCTYPE html><html><head><meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\"><style rel=\"stylesheet\" type=\"text/css\">@charset \"utf-8\";\r\n\r\nbody { background-color: rgba(255, 255, 255, 0.7); overflow-y: scroll; }\r\n\r\n.pop-conts { height: 100%; padding: 0.5rem; overflow-y: hidden; }\r\n\r\n.btnarea_c { margin-bottom: 5px; text-align: center; }\r\n\r\n.btnarea_c .btn { width: 200px; height: 40px; color: rgb(255, 255, 255); vertical-align: middle; background-color: rgb(102, 102, 102); border-radius: 3px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; }\r\n\r\n.tab-container { display: flex; flex-direction: column; }\r\n\r\n.tab-row { display: flex; }\r\n\r\n.tab { background-color: rgb(110, 110, 110); border: 1px solid rgb(204, 204, 204); text-align: center; color: rgb(255, 255, 255); flex: 1 1 0%; padding: 5px; }\r\n\r\n.tab:hover { cursor: pointer; text-decoration: underline; }\r\n\r\n.tab.active { background-color: rgb(215, 24, 70); font-weight: bold; }\r\n\r\n.fix-wrapper { margin-bottom: 1rem; }\r\n\r\n.fix-scroller { margin-left: 0px; width: 100%; height: 100%; }\r\n\r\n.fix-table { width: 100%; margin-top: 1rem; }\r\n\r\n.fix-table thead th { background-color: rgb(241, 241, 241); font-weight: bold; }\r\n\r\n.fix-table thead th, .fix-table tbody td { height: 30px; padding: 1px; }\r\n\r\n.fix-table tbody td.cost { text-align: right; }\r\n\r\n.fix-info { margin-top: 1rem; margin-left: 0px; background-color: rgb(241, 241, 241); padding: 0.6rem; }\r\n\r\n.info { text-align: center; font-weight: bold; font-size: 1.2rem; letter-spacing: 3px; }\r\n\r\n.fix-table thead th.lastHead { width: 20%; }</style>\n\t\n\t\n\t<meta http-equiv=\"Content-Script-Type\" content=\"text/javascript\">\n    <meta http-equiv=\"Content-Style-Type\" content=\"text/css\">\n    <meta http-equiv=\"imagetoolbar\" content=\"no\">\n    <meta http-equiv=\"Cache-Control\" content=\"no-cache; no-store; no-save\">\n    <meta http-equiv=\"expires\" content=\"0\">\n    <meta http-equiv=\"pragma\" content=\"no-cache\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge,chrome=1\">\n    \n\t<meta content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\" name=\"viewport\">\n\t<meta name=\"viewport\" content=\"width=1100, user-scalable=no\">\n\t<meta name=\"description\" content=\"\">\n\t<meta name=\"keyword\" content=\"\">\n\n\t<script type=\"text/javascript\" src=\"https://move.lxpantos.com/mvinst/common/js/jquery-2.1.1.min.js\"></script>\n\t<script type=\"text/javascript\" src=\"https://move.lxpantos.com/mvinst/common/js/common.js?ver=20261012204150\"></script>\n\t<script type=\"text/javascript\" src=\"https://move.lxpantos.com/mvinst/common/js/dui_prototype.js\"></script>\n\t<script type=\"text/javascript\" src=\"https://move.lxpantos.com/mvinst/common/js/util.js?ver=20261012204150\"></script>\n\t<script type=\"text/javascript\" src=\"https://move.lxpantos.com/mvinst/common/js/xsync.js\"></script>\n\t<script type=\"text/javascript\" src=\"https://move.lxpantos.com/mvinst/common/js/saymessage.js\"></script>\n\n\t<link rel=\"stylesheet\" type=\"text/css\" href=\"https://move.lxpantos.com/mvinst/common/css/common.css?ver=20261012204150\">\n\n<script type=\"text/javascript\">\n\tconst headers = new Array();\t // Tab배열\n\tconst bodys = new Array(); \t// Table배열\n\n\t$(document).ready(\n\t\tfunction() {\n\t       \t//팝업 공지 RITM2082856\n\t       \tpopImgLoad(\"priceTable\");\n\t\t\t\n\t\t\t// PC, 모바일 체크 \n\t\t\tif( mobilecheck() == true ){\n        \t\tvar actionUrl = \"/mvinst/m_priceTable.jsp\";\n\t\t\t\t//location.href = actionUrl;\n\t\t\t\t//IOS에서 시간차이로 인한 스크립트 에러 발생하여, 시간 지연후 이동하도록 변경 > 고객요청으로 1초로 변경 25.04.16\n\t\t\t\tsetTimeout(function(){\n\t\t\t\t\tlocation.href = actionUrl;\n\t\t\t\t}, 1000);\n\t\t\t} else {\n\t        \t$(\"body\").css(\"display\",\"block\");\n\t        \t// 비용단가 조회 \n\t\t\t\tvar aJax = new devon.xSync(\"/mvinst/mvInstProd/retrievePriceTable.ajax\");\n\t\t\t\taJax.addQuery(\"callback\", \"priceTableSearchInfo_callbackFunc\");\n\t\t\t\taJax.fire();\n           }\n\t});\n\n\t window.mobilecheck = function() {\n         var check = false;\n         (function(a){if(/(iPhone|android|bb\\d+|meego).+mobile|avantgo|bada\\/|blackberry|blazer|compal|elaine|fennec|hiptop|iemobile|ip(hone|od)|iris|kindle|lge |maemo|midp|mmp|mobile.+firefox|netfront|opera m(ob|in)i|palm( os)?|phone|p(ixi|re)\\/|plucker|pocket|psp|series(4|6)0|symbian|treo|up\\.(browser|link)|vodafone|wap|windows ce|xda|xiino/i.test(a)||/1207|6310|6590|3gso|4thp|50[1-6]i|770s|802s|a wa|abac|ac(er|oo|s\\-)|ai(ko|rn)|al(av|ca|co)|amoi|an(ex|ny|yw)|aptu|ar(ch|go)|as(te|us)|attw|au(di|\\-m|r |s )|avan|be(ck|ll|nq)|bi(lb|rd)|bl(ac|az)|br(e|v)w|bumb|bw\\-(n|u)|c55\\/|capi|ccwa|cdm\\-|cell|chtm|cldc|cmd\\-|co(mp|nd)|craw|da(it|ll|ng)|dbte|dc\\-s|devi|dica|dmob|do(c|p)o|ds(12|\\-d)|el(49|ai)|em(l2|ul)|er(ic|k0)|esl8|ez([4-7]0|os|wa|ze)|fetc|fly(\\-|_)|g1 u|g560|gene|gf\\-5|g\\-mo|go(\\.w|od)|gr(ad|un)|haie|hcit|hd\\-(m|p|t)|hei\\-|hi(pt|ta)|hp( i|ip)|hs\\-c|ht(c(\\-| |_|a|g|p|s|t)|tp)|hu(aw|tc)|i\\-(20|go|ma)|i230|iac( |\\-|\\/)|ibro|idea|ig01|ikom|im1k|inno|ipaq|iris|ja(t|v)a|jbro|jemu|jigs|kddi|keji|kgt( |\\/)|klon|kpt |kwc\\-|kyo(c|k)|le(no|xi)|lg( g|\\/(k|l|u)|50|54|\\-[a-w])|libw|lynx|m1\\-w|m3ga|m50\\/|ma(te|ui|xo)|mc(01|21|ca)|m\\-cr|me(rc|ri)|mi(o8|oa|ts)|mmef|mo(01|02|bi|de|do|t(\\-| |o|v)|zz)|mt(50|p1|v )|mwbp|mywa|n10[0-2]|n20[2-3]|n30(0|2)|n50(0|2|5)|n7(0(0|1)|10)|ne((c|m)\\-|on|tf|wf|wg|wt)|nok(6|i)|nzph|o2im|op(ti|wv)|oran|owg1|p800|pan(a|d|t)|pdxg|pg(13|\\-([1-8]|c))|phil|pire|pl(ay|uc)|pn\\-2|po(ck|rt|se)|prox|psio|pt\\-g|qa\\-a|qc(07|12|21|32|60|\\-[2-7]|i\\-)|qtek|r380|r600|raks|rim9|ro(ve|zo)|s55\\/|sa(ge|ma|mm|ms|ny|va)|sc(01|h\\-|oo|p\\-)|sdk\\/|se(c(\\-|0|1)|47|mc|nd|ri)|sgh\\-|shar|sie(\\-|m)|sk\\-0|sl(45|id)|sm(al|ar|b3|it|t5)|so(ft|ny)|sp(01|h\\-|v\\-|v )|sy(01|mb)|t2(18|50)|t6(00|10|18)|ta(gt|lk)|tcl\\-|tdg\\-|tel(i|m)|tim\\-|t\\-mo|to(pl|sh)|ts(70|m\\-|m3|m5)|tx\\-9|up(\\.b|g1|si)|utst|v400|v750|veri|vi(rg|te)|vk(40|5[0-3]|\\-v)|vm40|voda|vulc|vx(52|53|60|61|70|80|81|83|85|98)|w3c(\\-| )|webc|whit|wi(g |nc|nw)|wmlb|wonu|x700|yas\\-|your|zeto|zte\\-/i.test(a.substr(0,4))) check = true;})(navigator.userAgent||navigator.vendor||window.opera);\n         return check;\n     };\n     \n    // 비용단가 조회 callback\n\tvar priceTableSearchInfo_callbackFunc = function(json, instance, node, dom) {\n\t\ttry {\n\n\t\t\tif (json.attribute1 == null || json.attribute1 == undefined || json.attribute1.length == 0) {\n\t\t\t\talert(\"조회 내역이 없습니다!\");\n\t\t\t\treturn false;\n\t\t\t}\n\n\t\t\t// Tab배열, Table배열 추출 \n\t\t\tvar element = null;\n\n\t\t\tfor (var i = 0; i < json.attribute1.length; i++) {\n\t\t\t\tvar addFlag = false;\n\t\t\t\tvar keys = json.attribute1[i].$text;\n\n\t\t\t\tif (!headers.includes(keys)) {\n\t\t\t\t\theaders.push(keys);\n\n\t\t\t\t\taddFlag = true;\n\t\t\t\t\telement = new Array();\n\t\t\t\t}\n\n\t\t\t\tvar values = new Object();\n\t\t\t\tvalues.attribute1 = json.attribute1[i].$text;\n\t\t\t\tvalues.cdNm = json.cdNm[i].$text;\n\t\t\t\tvalues.olType2Nm = json.olType2Nm[i].$text;\n\t\t\t\tvalues.rmvSaleCost = json.rmvSaleCost[i].$text;\n\t\t\t\tvalues.instSaleCost = json.instSaleCost[i].$text;\n\t\t\t\tvalues.mvSaleCost = json.mvSaleCost[i].$text;\n\t\t\t\telement.push(values);\n\n\t\t\t\tif (addFlag) {\n\t\t\t\t\tbodys.push(element);\n\t\t\t\t}\n\t\t\t}\n\n\t\t\t// Tab 생성\n\t\t\tgenerateTabs();\n\n\t\t} catch (e) {\n\t\t\talert(e);\n\t\t}\n\t}\n\n\tfunction generateTabs() {\n\t\tconst tabContainer = document.getElementById(\"tab-container\");\n\n\t\t// Tab 2줄 고정 \n\t\tconst totalTabs = headers.length;\n\t\tconst firstRowCount = Math.ceil(totalTabs / 2);\n\t\tconst secondRowCount = totalTabs - firstRowCount;\n\n\t\t// 상단 Tab\n\t\tconst firstRowDiv = document.createElement(\"div\");\n\t\tfirstRowDiv.classList.add(\"tab-row\");\n\t\tfor (var i = 0; i < firstRowCount; i++) {\n\t\t\t(function(tabId, index) {\n\t\t\t\tconst tab = document.createElement(\"div\");\n\t\t\t\ttab.textContent = tabId.toUpperCase();\n\t\t\t\ttab.className = \"tab\" + (index === 0 ? \" active\" : \"\");\n\t\t\t\ttab.onclick = function() {\n\t\t\t\t\t// 탭 클릭 css 적용 \n\t\t\t\t\tconst tabs = document.querySelectorAll('.tab');\n\t\t\t\t\tfor (var j = 0; j < tabs.length; j++) {\n\t\t\t\t\t\t  tabs[j].classList.remove('active');\n\t\t\t\t\t}\n\t\t\t\t\ttabs[index].classList.add('active');\n\t\t\t\t\t\n\t\t\t\t\t// Table 생성\n\t\t\t\t\tshowTable(index);\n\t\t\t\t};\n\t\t\t\tfirstRowDiv.appendChild(tab);\n\t\t\t})(headers[i], i);\n\t\t}\n\t\ttabContainer.appendChild(firstRowDiv);\n\n\t\t// 하단 Tab\n\t\tif (secondRowCount > 0) {\n\t\t\tconst secondRowDiv = document.createElement(\"div\");\n\t\t\tsecondRowDiv.classList.add(\"tab-row\");\n\t\t\tfor (var i = firstRowCount; i < totalTabs; i++) {\n\t\t\t\t(function(tabId, index) {\n\t\t\t\t\tconst tab = document.createElement(\"div\");\n\t\t\t\t\ttab.textContent = tabId.toUpperCase();\n\t\t\t\t\ttab.className = \"tab\";\n\t\t\t\t\ttab.onclick = function() {\n\t\t\t\t\t\t// 탭 클릭 css 적용 \n\t\t\t\t\t\tconst tabs = document.querySelectorAll('.tab');\n\t\t\t\t\t\tfor (var j = 0; j < tabs.length; j++) {\n\t\t\t\t\t\t\t  tabs[j].classList.remove('active');\n\t\t\t\t\t\t}\n\t\t\t\t\t\ttabs[index].classList.add('active');\n\t\t\t\t\t\t\n\t\t\t\t\t\t// Table 생성\n\t\t\t\t\t\tshowTable(index);\n\t\t\t\t\t};\n\t\t\t\t\tsecondRowDiv.appendChild(tab);\n\t\t\t\t})(headers[i], i);\n\t\t\t}\n\t\t\ttabContainer.appendChild(secondRowDiv);\n\t\t}\n\n\t\t// 최초 index 0번 데이터 테이블 출력 \n\t\tshowTable(0);\n\n\t\t$(\"body\").css(\"display\",\"block\");\n\t}\n\n\tfunction showTable(index) {\n\t\tconst tableHeader = document.getElementById(\"table-header\");\n\t\tconst tableBody = document.getElementById(\"table-body\");\n\t\ttableHeader.innerHTML = \"\";\n\t\ttableBody.innerHTML = \"\";\n\t\t\n\t\t// 테이블 tHead \n\t\tconst tHead = [ \"구분\", \"품목\", \"품명\", \"철거비용\", \"설치비용\", \"이전설치 비용 </br>(철거+설치+기본운송비용 4만원)\" ];\n\t\tfor (var i = 0; i < tHead.length; i++) {\n\t\t\tconst th = document.createElement(\"th\");\n\t\t\tth.innerHTML = tHead[i];\n\t\t\tif(i==5){\n\t\t\t\tth.className = \"lastHead\"; \n\t\t\t}\n\t\t\ttableHeader.appendChild(th);\n\t\t}\n\n\t\t// 테이블 tBody\n\t\tconst data = bodys[index];\n\t\tvar prevAtt = null;\n\t\tvar prevCdNm = null;\n\n\t\tfor (var i = 0; i < data.length; i++) {\n\t\t\tconst row = document.createElement(\"tr\");\n\n\t\t\tif (data[i].attribute1 !== prevAtt) {\n\t\t\t\tconst attCell = document.createElement(\"td\");\n\t\t\t\tattCell.textContent = data[i].attribute1;\n\t\t\t\tconst attRowSpan = calculateRowSpan(data, i, \"attribute1\",data[i].attribute1, null, null);\n\t\t\t\tattCell.rowSpan = attRowSpan;\n\t\t\t\trow.appendChild(attCell);\n\t\t\t\tprevAtt = data[i].attribute1;\n\t\t\t}\n\n\t\t\tif (data[i].cdNm !== prevCdNm || data[i].attribute1 !== prevAtt) {\n\t\t\t\tconst cdNmCell = document.createElement(\"td\");\n\t\t\t\tcdNmCell.textContent = data[i].cdNm;\n\t\t\t\tconst cdNmRowSpan = calculateRowSpan(data, i, \"attribute1\",data[i].attribute1, \"cdNm\", data[i].cdNm);\n\t\t\t\tcdNmCell.rowSpan = cdNmRowSpan;\n\t\t\t\trow.appendChild(cdNmCell);\n\t\t\t\tprevCdNm = data[i].cdNm;\n\t\t\t}\n\n\t\t\tconst oltypeCell = document.createElement(\"td\");\n\t\t\toltypeCell.textContent = data[i].olType2Nm;\n\t\t\trow.appendChild(oltypeCell);\n\n\t\t\tconst rmvSaleCell = document.createElement(\"td\");\n\t\t\trmvSaleCell.textContent = data[i].rmvSaleCost;\n\t\t\trmvSaleCell.className = \"cost\"; \n\t\t\trow.appendChild(rmvSaleCell);\n\n\t\t\tconst instSaleCell = document.createElement(\"td\");\n\t\t\tinstSaleCell.textContent = data[i].instSaleCost;\n\t\t\tinstSaleCell.className = \"cost\"; \n\t\t\trow.appendChild(instSaleCell);\n\n\t\t\tconst mvSaleCell = document.createElement(\"td\");\n\t\t\tmvSaleCell.textContent = data[i].mvSaleCost;\n\t\t\tmvSaleCell.className = \"cost\"; \n\t\t\trow.appendChild(mvSaleCell);\n\n\t\t\ttableBody.appendChild(row);\n\t\t}\n\t}\n\n\tfunction calculateRowSpan(data, index, key1, value1, key2, value2) {\n\t\tvar count = 0;\n\t\tfor (var j = index; j < data.length; j++) {\n\t\t\tif (data[j][key1] === value1 && (!key2 || data[j][key2] === value2)) {\n\t\t\t\tcount++;\n\t\t\t} else {\n\t\t\t\tbreak;\n\t\t\t}\n\t\t}\n\t\treturn count;\n\t}\n\t\n\tfunction btnClose() {\n\t\t window.close();\n  \t}\n</script>\n\n\n\n<title>LX판토스 이전설치</title>\n</head>\n<body border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"display: block;\">\n\t<div class=\"pop-container\">\n\t\t<div class=\"pop_header\">\n\t\t\t<h1>비용 안내</h1>\n\t\t</div>\n\t\t<div class=\"pop-conts\">\n\t\t\t<div class=\"prd-container\">\n\t\t\t\t<!-- 고정 탭 -->\n\t\t\t\t<div id=\"tab-container\" class=\"tab-container\"><div class=\"tab-row\"><div class=\"tab active\">TV</div><div class=\"tab\">냉장고</div><div class=\"tab\">세탁기&amp;건조기</div><div class=\"tab\">시그니처</div><div class=\"tab\">정수기</div></div><div class=\"tab-row\"><div class=\"tab\">에어컨</div><div class=\"tab\">식기세척기</div><div class=\"tab\">전기레인지</div><div class=\"tab\">오븐</div><div class=\"tab\">기타</div></div></div>\n\n\t\t\t\t<!-- 고정 테이블 -->\n\t\t\t\t<div id=\"table-container\" class=\"fix-wrapper\">\n\t\t\t\t\t<div class=\"fix-scroller\">\n\t\t\t\t\t\t<table class=\"fix-table\">\n\t\t\t\t\t\t\t<thead>\n\t\t\t\t\t\t\t\t<tr id=\"table-header\"><th>구분</th><th>품목</th><th>품명</th><th>철거비용</th><th>설치비용</th><th class=\"lastHead\">이전설치 비용 <br>(철거+설치+기본운송비용 4만원)</th></tr>\n\t\t\t\t\t\t\t</thead>\n\t\t\t\t\t\t\t<tbody id=\"table-body\"><tr><td rowspan=\"15\">TV</td><td rowspan=\"3\">127cm미만(50 미만)</td><td>데스크</td><td class=\"cost\">28,000</td><td class=\"cost\">39,000</td><td class=\"cost\">107,000</td></tr><tr><td>벽걸이</td><td class=\"cost\">50,000</td><td class=\"cost\">71,000</td><td class=\"cost\">161,000</td></tr><tr><td>천장형</td><td class=\"cost\">77,000</td><td class=\"cost\">106,000</td><td class=\"cost\">223,000</td></tr><t